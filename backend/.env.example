# ==============================================================================
# Split Bro - Environment Configuration Template
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000

# MongoDB Database Connection String
# Local Docker/System: mongodb://127.0.0.1:27017/splitbro
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/splitbro?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/splitbro

# JSON Web Token Configuration (use a strong random string >= 32 characters in production)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# File Upload Configuration (5MB limit in bytes)
MAX_FILE_SIZE=5242880

# Allowed CORS Origins (comma separated)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500
