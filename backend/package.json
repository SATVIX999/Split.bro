{
  "name": "split-bro",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "morgan": "^1.12.1",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "testMatch": [
      "**/backend/tests/**/*.test.js",
      "**/tests/**/*.test.js",
      "**/server/tests/**/*.test.js"
    ],
    "verbose": true,
    "clearMocks": true,
    "detectOpenHandles": true,
    "forceExit": true,
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "(backend|server)/src/**/*.js",
      "!(backend|server)/src/scripts/**",
      "!(backend|server)/src/server.js"
    ]
  }
}
